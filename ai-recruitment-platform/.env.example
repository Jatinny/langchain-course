# ======================================================
# AI Recruitment Platform — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ======================================================

# ---- Application ----
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ---- AI / LLM ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# ---- Databases ----
DATABASE_URL=postgresql+asyncpg://recruitment:recruitment@localhost:5432/recruitment
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Search ----
ELASTICSEARCH_URL=http://localhost:9200
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1-aws

# ---- Contact Enrichment ----
APOLLO_API_KEY=
HUNTER_API_KEY=
CLEARBIT_API_KEY=
ROCKETREACH_API_KEY=

# ---- LinkedIn ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---- Gmail / Email ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=RecruitAI

# ---- WhatsApp ----
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256

# ---- AWS ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_RESUMES=recruitment-resumes-dev

# ---- Monitoring ----
SENTRY_DSN=
DATADOG_API_KEY=

# ---- Feature Flags ----
ENABLE_WHATSAPP_OUTREACH=false
ENABLE_LINKEDIN_AUTOMATION=false
ENABLE_AUTO_FOLLOWUP=true
ENABLE_MARKET_INTELLIGENCE=true
